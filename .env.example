# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# MongoDB connection string
# Local: mongodb://localhost:27017/altaf_portfolio
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/altaf_portfolio
# If this is left unset or unreachable, the contact form still works for
# visitors — submissions are logged to a local fallback file instead (see
# src/app/api/contact/route.js) — but you should set a real Atlas URI before
# deploying so submissions are actually saved durably.
MONGODB_URI=mongodb://localhost:27017/altaf_portfolio

# Your deployed site URL (used for correct social share preview images).
# Leave unset for local dev — it falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
